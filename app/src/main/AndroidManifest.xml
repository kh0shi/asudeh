<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ADR-0002: مجوز android.permission.INTERNET عمداً اینجا نیست و CI روی
      manifest ادغام‌شده بررسی می‌کند که هیچ کتابخانه‌ای آن را اضافه نکرده باشد.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- فقط برای زمان‌بندی دوبارهٔ «خلاصه» (D40) پس از روشن شدن گوشی. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      اختیاری، و فقط وقتی کاربر سیم ارسال را عوض می‌کند خواسته می‌شود (D27): فهرست
      سیم‌کارت‌های فعال و شمارهٔ خود کاربر برای جدا کردنش از اعضای MMS گروهی.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      آسوده برای کار کردن به‌عنوان اپ پیامک به سخت‌افزار تلفن نیاز دارد، ولی
      `required="false"` است تا روی دستگاهی بدون سیم‌کارت هم نصب شود و پیامک‌های
      ذخیره‌شده را فقط-خواندنی نشان بدهد (همان رفتار D47 وقتی اپ پیش‌فرض نیست).
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".app.AsudehApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Asudeh">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <!-- «اشتراک‌گذاری» متن یا تصویر از اپ‌های دیگر با آسوده. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- اپ پیش‌فرض پیامک باید هر چهار جزء زیر را داشته باشد. -->
        <receiver
            android:name="ir.asudehapp.sms.telephony.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="ir.asudehapp.sms.telephony.MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name="ir.asudehapp.sms.telephony.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- نتیجهٔ ارسال هر تکهٔ پیامک و گزارش تحویل؛ فقط PendingIntent خود اپ به آن می‌رسد. -->
        <receiver
            android:name="ir.asudehapp.sms.telephony.SmsSentReceiver"
            android:exported="false" />

        <!-- نتیجهٔ دریافت و ارسال MMS از سرویس سیستم (D26). -->
        <receiver
            android:name="ir.asudehapp.sms.telephony.MmsResultReceiver"
            android:exported="false" />

        <!--
          فایل‌های موقت PDU. سرویس MMS سیستم پیام را در آن می‌نویسد یا از آن
          می‌خواند؛ برای همین اپ مجوز INTERNET لازم ندارد (ADR-0002).
        -->
        <provider
            android:name="ir.asudehapp.sms.telephony.MmsFileProvider"
            android:authorities="${applicationId}.mmsfiles"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- دکمه‌های اعلان: کپی رمز، پاسخ، خوانده شد (D41). -->
        <receiver
            android:name="ir.asudehapp.sms.telephony.NotificationActionReceiver"
            android:exported="false" />

        <!-- «خلاصه» (D40). -->
        <receiver
            android:name="ir.asudehapp.sms.telephony.DigestReceiver"
            android:exported="false" />
        <receiver
            android:name="ir.asudehapp.sms.telephony.DigestRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
